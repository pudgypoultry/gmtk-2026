[node name="Line2_complete" type="Node" parent="DialogueStateManager" unique_id=766618580 node_paths=PackedStringArray("next_state")]
script = ExtResource("5_kpcjh")
text = "\"I'm glad you've finally learned how to draw your sword!\""
